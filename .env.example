# Painel de atendimento (/painel) — copie para .env.local (local) ou cadastre na Vercel (produção).
# Sem DATABASE_URL e sem WHATSAPP_TOKEN, em desenvolvimento o painel usa um banco local
# (.data/pglite) e o WhatsApp fica em "modo simulação".

# Banco Postgres (Neon, pela integração da Vercel)
DATABASE_URL=

# Segredo para assinar a sessão do painel (gere com: openssl rand -base64 32)
SESSION_SECRET=

# WhatsApp Cloud API (Meta for Developers → app da Bendita → WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Texto qualquer, igual ao informado na configuração do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Opcional
WHATSAPP_API_VERSION=v23.0
